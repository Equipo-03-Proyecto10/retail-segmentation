# Copy to .env and adjust. .env is gitignored; this file is not.
# Every value here is a safe local default. No real secret belongs in either file.

# PostgreSQL. The application connects as a restricted role, never as the role
# that owns the schema — see docs/backlog.md F1-05.
# On the VM use localhost:5432 and retail_app as below, with its real password.
# PostgreSQL stays on loopback; workstation access uses an SSH tunnel, not a
# public database listener. Verification: deploy/postgresql/README.md.
#
# sql/00_create_database.sql creates that role. It reads no password of its
# own: pass one with `psql -v app_password=...` on any real host, and it
# otherwise falls back to the same local default written below.
DATABASE_URL=postgresql://retail_app:retail_app@localhost:5432/retail

# Service database roles (ADR-0034, F13-07). sql/00_create_database.sql creates
# one LOGIN role per service plus the bench build, and reads each password
# from `psql -v svc_<suffix>_password=...`; without one, the role's password is
# its own name, the local default written below. On the instance, pass every
# value from these variables, and never keep the defaults.
#
# A service reaches PostgreSQL through the socket mounted into its container,
# so its own DATABASE_URL has this form (each service reads it, not the web):
#   DATABASE_URL=postgresql://svc_<suffix>@/retail?host=/run/postgresql
SVC_AUTH_DB_PASSWORD=svc_auth
SVC_USERS_DB_PASSWORD=svc_users
SVC_PRODUCTS_DB_PASSWORD=svc_products
SVC_CATEGORIES_DB_PASSWORD=svc_categories
SVC_STORES_DB_PASSWORD=svc_stores
SVC_STOCK_DB_PASSWORD=svc_stock
SVC_CUSTOMERS_DB_PASSWORD=svc_customers
SVC_PREFERENCES_DB_PASSWORD=svc_preferences
SVC_SALES_DB_PASSWORD=svc_sales
SVC_SEGMENTS_DB_PASSWORD=svc_segments
SVC_RECOMMENDATIONS_DB_PASSWORD=svc_recommendations
SVC_ENGAGEMENT_DB_PASSWORD=svc_engagement
SVC_CHECKINS_DB_PASSWORD=svc_checkins
SVC_CAMPAIGNS_DB_PASSWORD=svc_campaigns
SVC_AUDIT_TRAIL_DB_PASSWORD=svc_audit_trail
SVC_PRODUCTS_BENCH_DB_PASSWORD=svc_products_bench

# Redis (ADR-0037), for the services only: the web never connects (Q-12).
# Each service signs in to both instances as its own ACL user, svc_<suffix>,
# with REDIS_<SUFFIX>_PASSWORD; its implementation story adds that variable
# beside its ACL line. The URLs carry no credentials. The ops user runs ACL
# LOAD and deploy/infra/check-redis.sh, and no service uses it; on the
# instance its password is generated once and kept out of every repository.
REDIS_STATE_URL=redis://redis-state:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_CUSTOMERS_PASSWORD=svc_customers
REDIS_CATEGORIES_PASSWORD=svc_categories
# categories-service starts its outbox relay and its stream consumer in-process;
# "false" turns both off (tests drive them by hand).
CATEGORIES_BACKGROUND_WORKERS=true
REDIS_OPS_PASSWORD=local-ops-only
REDIS_STOCK_PASSWORD=svc_stock
# sales-service (F14-18): its ACL line is services/sales/redis/sales.acl, for
# svc_sales on both instances; the local default is the user's own name.
REDIS_SALES_PASSWORD=svc_sales
REDIS_STORES_PASSWORD=svc_stores
REDIS_CHECKINS_PASSWORD=svc_checkins

# customer-preferences-service (F14-16): its ACL line is
# services/customer-preferences/redis/customer-preferences.acl, for the user
# svc_preferences on both instances; the local default is the user's own name.
REDIS_PREFERENCES_PASSWORD=svc_preferences

# users-service (F14-04): its ACL line is services/users/redis/users.acl.
REDIS_USERS_PASSWORD=svc_users

# engagement-service (F14-24): its ACL line is services/engagement/redis/engagement.acl,
# for the user svc_engagement on both instances (rate limits on redis-state, live
# counters on redis-cache); the local default is the user's own name. Its MongoDB
# password is MONGO_ENGAGEMENT_PASSWORD, below.
REDIS_ENGAGEMENT_PASSWORD=svc_engagement

# segments-service (F14-20): its ACL line is services/segments/redis/segments.acl,
# for the user svc_segments on both instances; the local default is the user's own name.
REDIS_SEGMENTS_PASSWORD=svc_segments

# auth-service (F14-02): its ACL line is services/auth/redis/auth.acl. It alone
# signs tokens (ADR-0036): AUTH_PRIVATE_KEY_PATH is the container path of the
# private key, mounted read-only from /etc/mosaiq/keys/auth-<kid>.pem on the
# instance and never kept in the repository; AUTH_KID names that key and the
# entry of the JWK Set at AUTH_JWKS_PATH (above), and the service refuses to
# start when they disagree. docker/distributed/auth-keys.sh makes a throwaway
# pair for a laptop; deploy/auth-keys.md is the rotation runbook. The access
# token lives 10 minutes, a session at most 12 hours.
REDIS_AUTH_PASSWORD=svc_auth
AUTH_KID=local-dev
AUTH_PRIVATE_KEY_PATH=/run/mosaiq/auth-local-dev.pem
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=43200

# MongoDB (ADR-0038), for engagement-service only; no other service and not the
# web connects. Only engagement's compose.yaml sets MONGO_URI. Its user,
# svc_engagement, lives in the database `engagement`, which
# services/engagement/mongo/init.js creates with the password it reads from
# MONGO_ENGAGEMENT_PASSWORD (F14-24); the local default is the user's own name,
# as for the svc_* PostgreSQL roles. The server's root account comes from a file
# outside the repository (deploy/infra/README.md), and no service uses it.
MONGO_URI=mongodb://svc_engagement:svc_engagement@mongodb:27017/engagement?authSource=engagement
MONGO_ENGAGEMENT_PASSWORD=svc_engagement

# The distributed stage on a laptop (F13-08): compose.distributed.yaml runs a
# development-only gateway, so both clients reach every service through one
# base URL, http://127.0.0.1:8080/api/<name>/ (the Android emulator reaches it
# as http://10.0.2.2:8080). compose.proxy.yaml also defaults to 8080; when you
# run both, move one of them (this one, or MOSAIQ_PROXY_PORT).
MOSAIQ_GATEWAY_PORT=8080

# Shared service-kit authentication and limits (F13-03). auth-service fixes
# AUTH_ISSUER for an instance; this reserved local value identifies no real
# issuer. Each service mounts the public JWKS and sets its own service name.
AUTH_ISSUER=https://auth.invalid/
AUTH_JWKS_PATH=/run/mosaiq/jwks.json
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_POOL_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=2
# MOSAIQ_SERVICE_NAME=

# products-service (F14-06). Its Redis password for the ACL user svc_products
# on both instances; the local default is the user's own name, as for the
# svc_* PostgreSQL roles.
REDIS_PRODUCTS_PASSWORD=svc_products
# The three switches of ADR-0042 rule 2; each defaults to true. CACHE_ENABLED
# gates every products:cache:* key, RATE_LIMIT_ENABLED (above) every
# products:rl:* key, and STREAM_CONSUMER_ENABLED the consumer group `products`
# on stream:products.v1.changed. OUTBOX_RELAY_ENABLED gates the relay that
# publishes that stream. They are off only to measure the bare service (F15-02).
CACHE_ENABLED=true
STREAM_CONSUMER_ENABLED=true
OUTBOX_RELAY_ENABLED=true

# Flask. Generate a real value for anything that is not a local machine:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The application refuses to start with this default unless FLASK_ENV is
# development.
FLASK_SECRET_KEY=dev-only-not-a-secret
FLASK_ENV=development
# Invalid PORT values, including ports outside 1–65535, fall back to 5000.
PORT=5000

# Session cookies. Leave false for local HTTP; set true on any host where TLS is
# terminated in front of the application — the instance, behind NGINX
# (F6-01/F6-03). HttpOnly and SameSite=Lax are always on.
SESSION_COOKIE_SECURE=false
# Server-side session lifetime. A session ends after 30 minutes without a
# request, or after 8 hours from sign-in even if it remains active. Values are
# seconds and invalid/non-positive values fall back to these safe defaults.
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Reverse proxy hops. 0 when the app is reached directly; 1 behind the single
# NGINX on the instance (F6-01) or the `compose.proxy.yaml` overlay. With
# nothing in front, trusting X-Forwarded-* headers lets a client forge its own
# address — keep this 0 unless a proxy is actually present.
TRUSTED_PROXY_HOPS=0

# Sign-in protection. Each Flask worker returns an HTML 429 with Retry-After
# after this many failures for one account or client in the window. NGINX also
# limits POST /login by client address across all Gunicorn workers; non-positive
# or invalid values fall back to these safe defaults.
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=900

# Application log threshold: DEBUG, INFO, WARNING or ERROR. Written to stderr,
# which journald captures once the app runs under systemd (F6-02).
LOG_LEVEL=INFO

# Uploaded images. Gitignored; the database stores the path, not the bytes.
UPLOAD_DIR=web/uploads
# Flask also caps the entire request at this limit plus 64 KiB of form overhead.
# Oversized requests receive a branded 413 page; per-file checks remain active.
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# The administrator's password on the instance, read ONLY by
# `flask --app web.app provision-administrator` and `rotate-password`
# (F4-06, docs/runbook-instance-accounts.md). There is deliberately no value
# here and no default anywhere: a password with a safe default is not one.
# Export it for the length of the command, or leave it unset and be asked.
# MOSAIQ_ADMIN_PASSWORD=
