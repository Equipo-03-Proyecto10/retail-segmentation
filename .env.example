# Copy to .env and adjust. .env is gitignored; this file is not.
# Every value here is a safe local default. No real secret belongs in either file.

# ---------------------------------------------------------------------------
# PostgreSQL: two roles, two DSNs. This split is not optional (D-14, R-18).
#
# audit_log is append-only, enforced by a statement trigger *and* by grants. A
# REVOKE has no effect against the role that owns the schema. If the application
# connects with the credentials that ran the migration, the second layer of
# enforcement does nothing and the audit trail is protected only by a trigger
# that the connecting role is allowed to drop.
#
#   POSTGRES_PASSWORD          schema owner (postgres). Runs alembic, DDL.
#   POSTGRES_RUNTIME_PASSWORD  app_runtime. Restricted. Cannot UPDATE, DELETE or
#                              TRUNCATE audit_log. Created by
#                              infra/sql/init/01-app-runtime-role.sh the first
#                              time the postgres container initializes its
#                              volume (R-18 is closed by S0-02: this is the two
#                              roles the comment used to say were a known gap).
#
#   DATABASE_MIGRATION_URL  schema owner. Runs alembic. Creates and alters.
#   DATABASE_URL            application runtime. Restricted role (app_runtime).
# ---------------------------------------------------------------------------
POSTGRES_DB=retail
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_RUNTIME_PASSWORD=app_runtime_dev_password

DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:postgres@localhost:5432/retail
DATABASE_URL=postgresql+psycopg://app_runtime:app_runtime_dev_password@localhost:5432/retail

# ---------------------------------------------------------------------------
# MongoDB and Redis (S0-02). Design: docs/data/mongodb-design.md,
# docs/data/redis-design.md.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://mongo:27017/retail
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Flask (application skeleton lands in S0-03; these are read by config classes
# once they exist).
# ---------------------------------------------------------------------------
FLASK_CONFIG=development
SECRET_KEY=dev-only-secret-change-me

# ---------------------------------------------------------------------------
# Cloud Storage (E-13). Local filesystem fallback for development per
# docs/scrum/01-product-backlog-epics.md; GCS is only wired up against a real
# bucket, never with credentials committed here.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
# GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=
