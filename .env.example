# Copy to .env and adjust. .env is gitignored; this file is not.
# Every value here is a safe local default. No real secret belongs in either file.

# PostgreSQL. The application connects as a restricted role, never as the role
# that owns the schema — see docs/backlog.md F1-05.
#
# sql/00_create_database.sql creates that role. It reads no password of its
# own: pass one with `psql -v app_password=...` on any real host, and it
# otherwise falls back to the same local default written below.
DATABASE_URL=postgresql://retail_app:retail_app@localhost:5432/retail

# Flask. Generate a real value for anything that is not a local machine:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=dev-only-not-a-secret
FLASK_ENV=development
PORT=5000

# Application log threshold: DEBUG, INFO, WARNING or ERROR. Written to stderr,
# which journald captures once the app runs under systemd (F6-02).
LOG_LEVEL=INFO

# Uploaded images. Gitignored; the database stores the path, not the bytes.
UPLOAD_DIR=web/uploads
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
