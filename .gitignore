# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
test-results/
.ruff_cache/
*.egg-info/
packages/kit-py/example/contracts/common/
packages/kit-py/example/wheels/
packages/kit-py/dist/
packages/kit-rs/target/
packages/kit-rs/examples/contracts/common/
# CI copies each service's contracts into its build context (ADR-0040).
services/*/contracts/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
service-account*.json

# Uploaded files. The database stores the path; the bytes are not versioned.
web/uploads/

# Never commit datasets
data/
*.csv
# The grant manifest is a contract, not a dataset: CI compares it with the
# database (contracts/db/README.md).
!contracts/db/grants.csv

# IDE and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Agent local context
CLAUDE.local.md
cookies.txt
.playwright-mcp/
