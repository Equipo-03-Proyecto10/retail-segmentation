# Local, throwaway values for the bench only. The twin forces its own rate
# limiter off in code; it has no cache.
DATABASE_URL=postgresql://svc_products_bench@/retail?host=/run/postgresql
REDIS_STATE_URL=redis://redis-state:6379/0
REDIS_PRODUCTS_BENCH_PASSWORD=svc_products_bench
AUTH_ISSUER=https://auth.invalid/
AUTH_JWKS_PATH=/run/mosaiq/jwks.json
MOSAIQ_SERVICE_NAME=products-service-rs

# products-service reads the same base (bench/env/products.env), so both builds
# answer the same `photo_url` (ADR-0078).
PRODUCTS_PHOTO_BASE_URL=http://localhost:5000/admin/products/image/
