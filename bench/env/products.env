# Local, throwaway values for the bench only. ADR-0042's fairness rules: no
# cache, no rate limit, and no stream worker competing for the CPU.
DATABASE_URL=postgresql://svc_products@/retail?host=/run/postgresql
REDIS_STATE_URL=redis://redis-state:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_PRODUCTS_PASSWORD=svc_products
AUTH_ISSUER=https://auth.invalid/
AUTH_JWKS_PATH=/run/mosaiq/jwks.json
MOSAIQ_SERVICE_NAME=products
CACHE_ENABLED=false
RATE_LIMIT_ENABLED=false
OUTBOX_RELAY_ENABLED=false
STREAM_CONSUMER_ENABLED=false
