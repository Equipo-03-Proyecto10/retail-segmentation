{
  "name": "mosaiq-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MOSAIQ back-office desktop client (XML over per-service XSD)",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "bundle:contracts": "node scripts/bundle-contracts.mjs",
    "build": "npm run bundle:contracts && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run bundle:contracts && vitest run",
    "test:window": "npm run build && xvfb-run -a playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "20.19.43",
    "electron": "38.8.6",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "xmllint-wasm": "5.3.0"
  }
}
