<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ci="https://mosaiq.maxthecoder.online/xml/check-ins/v1"
           xmlns:common="https://mosaiq.maxthecoder.online/xml/common/v1"
           targetNamespace="https://mosaiq.maxthecoder.online/xml/check-ins/v1"
           elementFormDefault="qualified">
  <xs:import namespace="https://mosaiq.maxthecoder.online/xml/common/v1"
             schemaLocation="../common/v1/common.xsd"/>

  <xs:simpleType name="Latitude">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-90"/>
      <xs:maxInclusive value="90"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Longitude">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-180"/>
      <xs:maxInclusive value="180"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Accuracy">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Reason">
    <xs:restriction base="xs:string">
      <xs:enumeration value="no_fix"/>
      <xs:enumeration value="store_location_unknown"/>
      <xs:enumeration value="low_accuracy"/>
      <xs:enumeration value="within_geofence"/>
      <xs:enumeration value="outside_geofence"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ReviewReason">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="500"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LoyaltyCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-HJKMNP-TV-Z]{26}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CampaignId">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="2147483647"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="CheckInRequest">
    <xs:sequence>
      <xs:element name="client_check_in_id" type="xs:string"/>
      <xs:element name="store_id" type="xs:integer"/>
      <xs:element name="occurred_at" type="xs:dateTime"/>
      <xs:sequence minOccurs="0">
        <xs:element name="latitude" type="ci:Latitude"/>
        <xs:element name="longitude" type="ci:Longitude"/>
        <xs:element name="accuracy_m" type="ci:Accuracy"/>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Review">
    <xs:sequence>
      <xs:element name="review_id" type="xs:long"/>
      <xs:element name="verified" type="xs:boolean"/>
      <xs:element name="reason" type="ci:ReviewReason"/>
      <xs:element name="reviewed_by" type="xs:string"/>
      <xs:element name="reviewed_at" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReviewRequest">
    <xs:sequence>
      <xs:element name="verified" type="xs:boolean"/>
      <xs:element name="reason" type="ci:ReviewReason"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CheckIn">
    <xs:sequence>
      <xs:element name="check_in_id" type="xs:string"/>
      <xs:element name="client_check_in_id" type="xs:string"/>
      <xs:element name="user_id" type="xs:string"/>
      <xs:element name="store_id" type="xs:integer"/>
      <xs:sequence minOccurs="0">
        <xs:element name="latitude" type="ci:Latitude"/>
        <xs:element name="longitude" type="ci:Longitude"/>
        <xs:element name="accuracy_m" type="ci:Accuracy"/>
      </xs:sequence>
      <xs:element name="distance_m" type="xs:decimal" minOccurs="0"/>
      <xs:element name="reason" type="ci:Reason"/>
      <xs:element name="auto_verified" type="xs:boolean"/>
      <xs:element name="verified" type="xs:boolean"/>
      <xs:element name="occurred_at" type="xs:dateTime"/>
      <xs:element name="recorded_at" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CheckInDetail">
    <xs:complexContent>
      <xs:extension base="ci:CheckIn">
        <xs:sequence>
          <xs:element name="reviews" type="ci:Review"
                      minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="CheckIns">
    <xs:sequence>
      <xs:element name="CheckIn" type="ci:CheckIn"
                  minOccurs="0" maxOccurs="unbounded"/>
      <xs:element ref="common:PageInfo"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CustomerVisitRequest">
    <xs:sequence>
      <xs:element name="loyalty_code" type="ci:LoyaltyCode"/>
      <xs:element name="store_id" type="xs:integer"/>
      <xs:element name="occurred_at" type="xs:dateTime"/>
      <xs:element name="campaign_id" type="ci:CampaignId" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CustomerVisit">
    <xs:sequence>
      <xs:element name="visit_id" type="xs:string"/>
      <xs:element name="customer_id" type="xs:string" minOccurs="0"/>
      <xs:element name="store_id" type="xs:integer"/>
      <xs:element name="campaign_id" type="ci:CampaignId" minOccurs="0"/>
      <xs:element name="occurred_at" type="xs:dateTime"/>
      <xs:element name="recorded_at" type="xs:dateTime"/>
      <xs:element name="recorded_by" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CustomerVisits">
    <xs:sequence>
      <xs:element name="CustomerVisit" type="ci:CustomerVisit"
                  minOccurs="0" maxOccurs="unbounded"/>
      <xs:element ref="common:PageInfo"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="CheckInRequest" type="ci:CheckInRequest"/>
  <xs:element name="CheckIn" type="ci:CheckIn"/>
  <xs:element name="CheckInDetail" type="ci:CheckInDetail"/>
  <xs:element name="CheckIns" type="ci:CheckIns"/>
  <xs:element name="Review" type="ci:Review"/>
  <xs:element name="ReviewRequest" type="ci:ReviewRequest"/>
  <xs:element name="CustomerVisitRequest" type="ci:CustomerVisitRequest"/>
  <xs:element name="CustomerVisit" type="ci:CustomerVisit"/>
  <xs:element name="CustomerVisits" type="ci:CustomerVisits"/>
</xs:schema>
