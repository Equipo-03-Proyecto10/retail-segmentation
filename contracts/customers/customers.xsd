<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cus="https://mosaiq.maxthecoder.online/xml/customers/v1"
           xmlns:common="https://mosaiq.maxthecoder.online/xml/common/v1"
           targetNamespace="https://mosaiq.maxthecoder.online/xml/customers/v1"
           elementFormDefault="qualified">
  <xs:import namespace="https://mosaiq.maxthecoder.online/xml/common/v1"
             schemaLocation="../common/v1/common.xsd"/>

  <xs:simpleType name="Uuid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Name">
    <xs:restriction base="xs:string">
      <xs:maxLength value="120"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Email">
    <xs:restriction base="xs:string">
      <xs:maxLength value="160"/>
      <xs:pattern value="[^@\s]+@[^@\s.]+(\.[^@\s.]+)+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Phone">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ChannelId">
    <xs:restriction base="xs:short"/>
  </xs:simpleType>

  <xs:complexType name="Customer">
    <xs:sequence>
      <xs:element name="customer_id" type="cus:Uuid"/>
      <xs:element name="name" type="cus:Name"/>
      <xs:element name="email" type="cus:Email" minOccurs="0"/>
      <xs:element name="phone" type="cus:Phone" minOccurs="0"/>
      <xs:element name="registration_channel_id" type="cus:ChannelId" minOccurs="0"/>
      <xs:element name="registered_on" type="xs:date" minOccurs="0"/>
      <xs:element name="loyalty_state" type="cus:LoyaltyState" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RegisterCustomerRequest">
    <xs:sequence>
      <xs:element name="name" type="cus:Name"/>
      <xs:element name="email" type="cus:Email" minOccurs="0"/>
      <xs:element name="phone" type="cus:Phone" minOccurs="0"/>
      <xs:element name="registration_channel_id" type="cus:ChannelId"/>
      <xs:element name="registered_on" type="xs:date" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CorrectCustomerRequest">
    <xs:sequence>
      <xs:element name="name" type="cus:Name" minOccurs="0"/>
      <xs:element name="email" type="cus:Email" minOccurs="0"/>
      <xs:element name="phone" type="cus:Phone" minOccurs="0"/>
      <xs:element name="registration_channel_id" type="cus:ChannelId" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Customers">
    <xs:sequence>
      <xs:element name="Customer" type="cus:Customer" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element ref="common:PageInfo"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="CardCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-HJKMNP-TV-Z]{26}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LoyaltyCardStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACTIVE"/>
      <xs:enumeration value="REVOKED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RevocationReason">
    <xs:restriction base="xs:string">
      <xs:enumeration value="LOST"/>
      <xs:enumeration value="STOLEN"/>
      <xs:enumeration value="REPLACED"/>
      <xs:enumeration value="CUSTOMER_REQUEST"/>
      <xs:enumeration value="OTHER"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LoyaltyState">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NONE"/>
      <xs:enumeration value="ACTIVE"/>
      <xs:enumeration value="REVOKED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="LoyaltyCard">
    <xs:sequence>
      <xs:element name="card_id" type="cus:Uuid"/>
      <xs:element name="customer_id" type="cus:Uuid"/>
      <xs:element name="code" type="cus:CardCode"/>
      <xs:element name="status" type="cus:LoyaltyCardStatus"/>
      <xs:element name="issued_at" type="xs:dateTime"/>
      <xs:element name="issued_by" type="cus:Uuid"/>
      <xs:element name="revoked_at" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="revoked_by" type="cus:Uuid" minOccurs="0"/>
      <xs:element name="revocation_reason" type="cus:RevocationReason" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LoyaltyCards">
    <xs:sequence>
      <xs:element name="LoyaltyCard" type="cus:LoyaltyCard" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element ref="common:PageInfo"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="IssueLoyaltyCardRequest">
    <xs:sequence>
      <xs:element name="customer_id" type="cus:Uuid"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RevokeLoyaltyCardRequest">
    <xs:sequence>
      <xs:element name="reason" type="cus:RevocationReason"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LookupLoyaltyCardRequest">
    <xs:sequence>
      <xs:element name="code" type="cus:CardCode"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LoyaltyCardLookup">
    <xs:sequence>
      <xs:element name="card_id" type="cus:Uuid"/>
      <xs:element name="customer_id" type="cus:Uuid"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Customer" type="cus:Customer"/>
  <xs:element name="Customers" type="cus:Customers"/>
  <xs:element name="RegisterCustomerRequest" type="cus:RegisterCustomerRequest"/>
  <xs:element name="CorrectCustomerRequest" type="cus:CorrectCustomerRequest"/>
  <xs:element name="LoyaltyCard" type="cus:LoyaltyCard"/>
  <xs:element name="LoyaltyCards" type="cus:LoyaltyCards"/>
  <xs:element name="IssueLoyaltyCardRequest" type="cus:IssueLoyaltyCardRequest"/>
  <xs:element name="RevokeLoyaltyCardRequest" type="cus:RevokeLoyaltyCardRequest"/>
  <xs:element name="LookupLoyaltyCardRequest" type="cus:LookupLoyaltyCardRequest"/>
  <xs:element name="LoyaltyCardLookup" type="cus:LoyaltyCardLookup"/>
</xs:schema>
