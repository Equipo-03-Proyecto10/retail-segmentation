<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sales="https://mosaiq.maxthecoder.online/xml/sales/v1"
           xmlns:common="https://mosaiq.maxthecoder.online/xml/common/v1"
           targetNamespace="https://mosaiq.maxthecoder.online/xml/sales/v1"
           elementFormDefault="qualified">
  <xs:import namespace="https://mosaiq.maxthecoder.online/xml/common/v1"
             schemaLocation="../common/v1/common.xsd"/>

  <xs:simpleType name="Uuid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A request price is any decimal: the service, not the schema, refuses a
       non-positive price or one with more than two places (invalid_price). -->
  <xs:complexType name="SaleLineInput">
    <xs:sequence>
      <xs:element name="product_id" type="xs:integer"/>
      <xs:element name="quantity" type="xs:integer"/>
      <xs:element name="unit_price" type="xs:decimal"/>
    </xs:sequence>
  </xs:complexType>

  <!-- lines may be absent: an empty sale is the service's no_lines, not a
       schema error. -->
  <xs:complexType name="SaleRequest">
    <xs:sequence>
      <xs:element name="customer_id" type="sales:Uuid"/>
      <xs:element name="store_id" type="xs:integer"/>
      <xs:element name="channel_id" type="xs:integer"/>
      <xs:element name="occurred_at" type="xs:dateTime"/>
      <xs:element name="lines" type="sales:SaleLineInput"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="Money">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+\.[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="SaleLine">
    <xs:sequence>
      <xs:element name="product_id" type="xs:integer"/>
      <xs:element name="quantity" type="xs:positiveInteger"/>
      <xs:element name="unit_price" type="sales:Money"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Sale">
    <xs:sequence>
      <xs:element name="sale_id" type="xs:long"/>
      <xs:element name="customer_id" type="sales:Uuid"/>
      <xs:element name="store_id" type="xs:integer"/>
      <xs:element name="channel_id" type="xs:integer"/>
      <xs:element name="occurred_at" type="xs:dateTime"/>
      <xs:element name="total" type="sales:Money"/>
      <xs:element name="lines" type="sales:SaleLine"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Sales">
    <xs:sequence>
      <xs:element name="Sale" type="sales:Sale"
                  minOccurs="0" maxOccurs="unbounded"/>
      <xs:element ref="common:PageInfo"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="ReversalKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CANCELLATION"/>
      <xs:enumeration value="RETURN"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A request quantity is any integer, and reason and resellable may be
       absent: the service, not the schema, answers invalid_quantity and
       reason_required. -->
  <xs:complexType name="SaleReversalLineInput">
    <xs:sequence>
      <xs:element name="product_id" type="xs:integer"/>
      <xs:element name="quantity" type="xs:integer"/>
      <xs:element name="reason" type="xs:string" minOccurs="0"/>
      <xs:element name="resellable" type="xs:boolean" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- reason and lines depend on the kind, so the service decides them
       (reason_required, no_return_lines, unexpected_lines). -->
  <xs:complexType name="SaleReversalRequest">
    <xs:sequence>
      <xs:element name="sale_id" type="xs:long"/>
      <xs:element name="kind" type="sales:ReversalKind"/>
      <xs:element name="reason" type="xs:string" minOccurs="0"/>
      <xs:element name="lines" type="sales:SaleReversalLineInput"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SaleReversalLine">
    <xs:sequence>
      <xs:element name="product_id" type="xs:integer"/>
      <xs:element name="quantity" type="xs:positiveInteger"/>
      <xs:element name="remaining_quantity" type="xs:nonNegativeInteger"/>
      <xs:element name="unit_price" type="sales:Money"/>
      <xs:element name="reason" type="xs:string" minOccurs="0"/>
      <xs:element name="resellable" type="xs:boolean"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SaleReversal">
    <xs:sequence>
      <xs:element name="reversal_id" type="xs:long"/>
      <xs:element name="sale_id" type="xs:long"/>
      <xs:element name="kind" type="sales:ReversalKind"/>
      <xs:element name="reason" type="xs:string" minOccurs="0"/>
      <xs:element name="customer_id" type="sales:Uuid"/>
      <xs:element name="store_id" type="xs:integer"/>
      <xs:element name="recorded_at" type="xs:dateTime"/>
      <xs:element name="recorded_by" type="sales:Uuid"/>
      <xs:element name="amount" type="sales:Money"/>
      <xs:element name="net_total" type="sales:Money"/>
      <xs:element name="lines" type="sales:SaleReversalLine"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SaleReversals">
    <xs:sequence>
      <xs:element name="SaleReversal" type="sales:SaleReversal"
                  minOccurs="0" maxOccurs="unbounded"/>
      <xs:element ref="common:PageInfo"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Channel">
    <xs:sequence>
      <xs:element name="channel_id" type="xs:integer"/>
      <xs:element name="name" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Channels">
    <xs:sequence>
      <xs:element name="Channel" type="sales:Channel"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="SaleRequest" type="sales:SaleRequest"/>
  <xs:element name="Sale" type="sales:Sale"/>
  <xs:element name="Sales" type="sales:Sales"/>
  <xs:element name="SaleReversalRequest" type="sales:SaleReversalRequest"/>
  <xs:element name="SaleReversal" type="sales:SaleReversal"/>
  <xs:element name="SaleReversals" type="sales:SaleReversals"/>
  <xs:element name="Channels" type="sales:Channels"/>
</xs:schema>
