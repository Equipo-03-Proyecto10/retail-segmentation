# A Rust service's image (ADR-0040), rendered by render.py into
# services/__NAME__/Dockerfile. The build context is services/__NAME__/ and
# nothing above it (ADR-0045): CI copies contracts/__NAME__/ and
# contracts/common/v1/ into services/__NAME__/contracts/ (git-ignored) before
# `docker build`, and this file copies them from inside that context.
#
# Layout it expects: its own Cargo.toml (package and binary named __NAME__, no
# [workspace]) and committed Cargo.lock, src/, and contracts/.

FROM rust:1.98.1-slim-trixie@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
RUN cargo build --release --locked \
    && install -m 0755 target/release/__NAME__ /usr/local/bin/__NAME__

FROM debian:trixie-20260918-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
WORKDIR /app
COPY --from=build /usr/local/bin/__NAME__ /usr/local/bin/__NAME__
COPY contracts/ ./contracts/

USER 10001:10001
EXPOSE __PORT__
ENTRYPOINT ["/usr/local/bin/__NAME__"]
