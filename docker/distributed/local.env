# Interpolation values for the files compose.distributed.yaml includes: the
# infrastructure project and each services/<name>/compose.yaml. They replace
# the instance paths those files default to with local stand-ins. Not read by
# any container. ${PWD} is the repository root, where every command runs.
IMAGE_TAG=local
MOSAIQ_SVC_ENV_DIR=${PWD}/docker/distributed/svc
MOSAIQ_PG_SOCKET=mosaiq-pgsocket
# auth-service signs locally, so the JWK Set every service mounts is the public
# half of a key pair that docker/distributed/auth-keys.sh makes (git-ignored).
# AUTH_KID names the file auth mounts and must equal svc/auth.env's.
MOSAIQ_JWKS_FILE=${PWD}/docker/distributed/keys/jwks.json
MOSAIQ_AUTH_KEY_DIR=${PWD}/docker/distributed/keys
AUTH_KID=local-dev
MOSAIQ_REDIS_ACL_DIR=mosaiq-redis-acl
MOSAIQ_MONGO_ROOT_ENV=${PWD}/docker/distributed/mongodb-root.env
