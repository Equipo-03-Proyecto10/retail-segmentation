{
  "description": "RFM by hand (F29-01, #886). Every purchase is given in calendar days before the instant, at the same local clock time, plus minutes. Expected values were computed by hand; see docs/evidence/f29-01-rfm-hand-computed.md.",
  "time_zone": "America/New_York",
  "window_days": 60,
  "instant": "2026-04-20T00:10:00-04:00",
  "frozen_boundaries": {
    "recency": [
      1,
      3,
      8,
      49
    ],
    "frequency": [
      8,
      5,
      3,
      2
    ],
    "monetary": [
      "80.00",
      "75.25",
      "60.00",
      "25.50"
    ]
  },
  "customers": [
    {
      "key": "edge_in",
      "note": "one purchase exactly on the window's first instant: a closed edge, so it counts",
      "purchases": [
        {
          "days_before": 60,
          "minutes": 0,
          "quantity": 1,
          "unit_price": "25.50"
        }
      ],
      "expected": {
        "state": "scored",
        "frequency": 1,
        "monetary": "25.50",
        "r_days": 60,
        "scores": [
          1,
          1,
          2
        ],
        "last_purchase": {
          "days_before": 60,
          "minutes": 0
        }
      }
    },
    {
      "key": "edge_out",
      "note": "one purchase one minute before the first instant: outside, so the customer has no purchase",
      "purchases": [
        {
          "days_before": 60,
          "minutes": -1,
          "quantity": 1,
          "unit_price": "500.00"
        }
      ],
      "expected": {
        "state": "unassigned",
        "frequency": 0,
        "monetary": "0.00",
        "r_days": null,
        "scores": null,
        "last_purchase": null
      }
    },
    {
      "key": "dst_trap",
      "note": "a 99.99 purchase 40 minutes before the calendar edge, which a 24-hour-day window would include; only the 10.00 purchase counts",
      "purchases": [
        {
          "days_before": 61,
          "minutes": 1400,
          "quantity": 1,
          "unit_price": "99.99"
        },
        {
          "days_before": 52,
          "minutes": 0,
          "quantity": 1,
          "unit_price": "10.00"
        }
      ],
      "expected": {
        "state": "scored",
        "frequency": 1,
        "monetary": "10.00",
        "r_days": 52,
        "scores": [
          1,
          1,
          1
        ],
        "last_purchase": {
          "days_before": 52,
          "minutes": 0
        }
      }
    },
    {
      "key": "dst_boundary",
      "note": "last purchase 49 calendar days back, across a clock change that makes it 1175 elapsed hours; R is 49 calendar days, the largest R that still scores 2",
      "purchases": [
        {
          "days_before": 55,
          "minutes": 0,
          "quantity": 1,
          "unit_price": "40.00"
        },
        {
          "days_before": 49,
          "minutes": 0,
          "quantity": 1,
          "unit_price": "35.25"
        }
      ],
      "expected": {
        "state": "scored",
        "frequency": 2,
        "monetary": "75.25",
        "r_days": 49,
        "scores": [
          2,
          2,
          4
        ],
        "last_purchase": {
          "days_before": 49,
          "minutes": 0
        }
      }
    },
    {
      "key": "upper_edge",
      "note": "a purchase exactly at the instant: the window is closed at both ends, so R is 0",
      "purchases": [
        {
          "days_before": 5,
          "minutes": 0,
          "quantity": 1,
          "unit_price": "20.00"
        },
        {
          "days_before": 0,
          "minutes": 0,
          "quantity": 1,
          "unit_price": "10.00"
        }
      ],
      "expected": {
        "state": "scored",
        "frequency": 2,
        "monetary": "30.00",
        "r_days": 0,
        "scores": [
          5,
          2,
          2
        ],
        "last_purchase": {
          "days_before": 0,
          "minutes": 0
        }
      }
    },
    {
      "key": "cancel_one",
      "note": "the newest sale was cancelled, so R comes from the 20-day sale and F counts one",
